{
  "name": "xbox-cloud-gaming-client",
  "version": "0.1.0",
  "description": "An open-source cloud gaming client for streaming games with ultra-low latency",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "cloud-gaming",
    "game-streaming",
    "webrtc",
    "low-latency",
    "xbox",
    "streaming"
