  "author": "Ytbeast186",
  "license": "MIT",
  "dependencies": {
    "wrtc": "^0.4.7",
    "webrtc": "^0.0.1",
    "express": "^4.18.2",
    "socket.io": "^4.5.4",
    "ffmpeg-static": "^5.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "dotenv": "^16.0.3",
    "winston": "^3.8.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "jest": "^29.3.1",
    "eslint": "^8.33.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
