{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "ssl": {
      "enabled": true,
      "cert": "./certs/server.crt",
      "key": "./certs/server.key"
    }
  },
  "streaming": {
    "resolution": "1080p",
    "fps": 60,
    "bitrate": "10000k",
    "codec": "h264",
    "preset": "fast",
    "adaptiveBitrate": true,
    "minBitrate": "2000k",
    "maxBitrate": "50000k"
  },
  "network": {
    "protocol": "webrtc",
    "encryption": "dtls",
    "stunServers": [
      "stun:stun.l.google.com:19302",
      "stun:stun1.l.google.com:19302"
    ],
    "turnServers": [
      {
        "urls": ["turn:relay.example.com"],
        "username": "user",
        "credential": "pass"
      }
    ]
  },
  "input": {
    "controller": {
      "enabled": true,
      "pollRate": 60
    },
    "keyboard": {
      "enabled": true
    },
    "mouse": {
      "enabled": true,
      "sensitivity": 1.0
    },
    "touchscreen": {
      "enabled": true
    }
  },
  "performance": {
    "maxLatency": 50,
    "bufferSize": 1024,
    "threads": 4
  },
  "logging": {
    "level": "info",
    "file": "./logs/app.log",
    "console": true
  },
  "security": {
    "enableAuthentication": true,
    "tokenExpiry": 3600,
    "rateLimit": {
      "enabled": true,
      "requestsPerMinute": 100
    }
  }
}
